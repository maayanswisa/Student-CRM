NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row Level Security - never expose to the client,
# never prefix with NEXT_PUBLIC_. Get it from Supabase Dashboard ->
# Project Settings -> API -> service_role key. Required for the /admin
# platform-analytics dashboard only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Comma-separated list of emails allowed to access /admin.
# Defaults to maayanswisa9@gmail.com if not set.
ADMIN_EMAILS=maayanswisa9@gmail.com
